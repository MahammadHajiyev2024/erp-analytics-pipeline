# Copy this file to .env and fill in real values. Never commit .env.

# ERPNext (source system)
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret

ERPNEXT_ADMIN_PASSWORD=your_admin-password
ERPNEXT_DB_ROOT_PASSWORD=your_db-root-password

ERPNEXT_BOOTSTRAP_API_KEY=the-api-key
ERPNEXT_BOOTSTRAP_API_SECRET=the-api-secret

# FRED (enrichment source)
FRED_API_KEY=your-fred-api-key

# Databricks (warehouse)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-access-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CATALOG=erp_analytics
