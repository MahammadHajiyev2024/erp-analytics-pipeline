		dataType: double
		sourceProviderType: decimal(18, 2)
		lineageTag: 61952609-c435-4c9b-acdf-5aab1b57f653
		summarizeBy: sum
		sourceColumn: invoice_amount_gbp

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

