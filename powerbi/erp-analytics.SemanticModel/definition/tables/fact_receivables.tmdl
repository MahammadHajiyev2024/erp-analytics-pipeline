table fact_receivables
	lineageTag: c8b894a4-ac56-4a10-bb0a-0b359f34605f

	measure 'Accounts Receivable' =
			VAR _gbp = SUM(fact_receivables[outstanding_amount_gbp])
			VAR _usd = SUM(fact_receivables[outstanding_amount_usd])
			RETURN SWITCH(SELECTEDVALUE('Currency'[Currency], "GBP"), "USD", _usd, _gbp)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: a29bd1ab-e600-4c9b-a263-7d2f4b65de63

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Overdue %' =
			DIVIDE(
					CALCULATE(SUM(fact_receivables[outstanding_amount_gbp]), fact_receivables[is_overdue] = TRUE()),
					SUM(fact_receivables[outstanding_amount_gbp])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8ecb3fcc-7376-4ee1-8329-77fd14d66b56

	measure 'Dynamic Order Volume' = ```

			VAR CurrentMin = MIN('Order Tiers'[Min])
			VAR CurrentMax = MAX('Order Tiers'[Max])
			-- This reads your slicer toggle. If nothing is selected, it defaults to GBP.
			VAR SelectedCurrency = SELECTEDVALUE('Currency'[Currency], "GBP")

			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fact_receivables[invoice_id]),
			    FILTER(
			        fact_receivables,
			        IF(
			            SelectedCurrency = "USD",
			            fact_receivables[invoice_amount_usd] >= CurrentMin && fact_receivables[invoice_amount_usd] < CurrentMax,
			            fact_receivables[invoice_amount_gbp] >= CurrentMin && fact_receivables[invoice_amount_gbp] < CurrentMax
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: a92b51a1-c4fb-4ed0-ac63-4eb74e0eaf75

