table fact_receivables
	lineageTag: c8b894a4-ac56-4a10-bb0a-0b359f34605f

	measure 'Accounts Receivable' =

			VAR _gbp = SUM(fact_receivables[outstanding_amount_gbp])
			VAR _usd = SUMX(fact_receivables, fact_receivables[outstanding_amount_gbp] * RELATED('dim_date'[usd_per_gbp]))
			RETURN
			SWITCH(SELECTEDVALUE('Currency'[Currency], "GBP"), "USD", _usd, _gbp)
		lineageTag: a29bd1ab-e600-4c9b-a263-7d2f4b65de63

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Currency'[Currency], "GBP"),
				    "USD", "$#,0.0",
				    "£#,0.0"
				)

	measure 'Overdue %' =
			DIVIDE(
					CALCULATE(SUM(fact_receivables[outstanding_amount_gbp]), fact_receivables[is_overdue] = TRUE()),
					SUM(fact_receivables[outstanding_amount_gbp])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8ecb3fcc-7376-4ee1-8329-77fd14d66b56

	measure 'Dynamic Order Volume' =

			VAR CurrentMin = MIN('Order Tiers'[Min])
			VAR CurrentMax = MAX('Order Tiers'[Max])
			-- This reads your slicer toggle. If nothing is selected, it defaults to GBP.
			VAR SelectedCurrency = SELECTEDVALUE('Currency'[Currency], "GBP")

			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fact_receivables[invoice_id]),
			    FILTER(
			        fact_receivables,
			        IF(
			            SelectedCurrency = "USD",
			            fact_receivables[invoice_amount_usd] >= CurrentMin && fact_receivables[invoice_amount_usd] < CurrentMax,
			            fact_receivables[invoice_amount_gbp] >= CurrentMin && fact_receivables[invoice_amount_gbp] < CurrentMax
			        )
			    )
			)
		formatString: #,0.0
		lineageTag: a92b51a1-c4fb-4ed0-ac63-4eb74e0eaf75

	measure 'Order Count' = DISTINCTCOUNT(fact_receivables[invoice_id])
		formatString: #,0.0
		lineageTag: c90cc2a6-f4d5-4ce1-886c-b6afbaaa4613

	measure 'Accounts Receivable by Tier' =

			VAR CurrentMin = MIN('Order Tiers'[Min])
			VAR CurrentMax = MAX('Order Tiers'[Max])
			VAR SelectedCurrency = SELECTEDVALUE('Currency'[Currency], "GBP")
			VAR _tierRows =
					FILTER(
					    fact_receivables,
					    IF(
					        SelectedCurrency = "USD",
					        fact_receivables[invoice_amount_usd] >= CurrentMin && fact_receivables[invoice_amount_usd] < CurrentMax,
					        fact_receivables[invoice_amount_gbp] >= CurrentMin && fact_receivables[invoice_amount_gbp] < CurrentMax
					    )
					)
			VAR _gbp = CALCULATE(SUM(fact_receivables[outstanding_amount_gbp]), _tierRows)
			VAR _usd = CALCULATE(SUM(fact_receivables[outstanding_amount_usd]), _tierRows)

			RETURN SWITCH(SelectedCurrency, "USD", _usd, _gbp)
		lineageTag: 5415404d-b03f-4c9b-b4b8-38969adcac7b

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Currency'[Currency], "GBP"),
				    "USD", "$#,0.0",
				    "£#,0.0"
				)

	measure 'Days Sales Outstanding' = DIVIDE([Accounts Receivable], [Net Revenue]) * COUNTROWS(VALUES(dim_date[date]))
		formatString: #,0.0
		lineageTag: 6f0a7e21-4b9f-4f41-9d92-4e3e52b1c4af

	measure 'Country Share of Total AR' = DIVIDE([Accounts Receivable], CALCULATE([Accounts Receivable], ALL(dim_customer[country])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9c4d8b6f-2e1a-4a7c-8f05-3b6e9d2a7c41

	measure 'Accounts Receivable YoY Growth %' =
			VAR _current = [Accounts Receivable]
			VAR _prior = CALCULATE([Accounts Receivable], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bd0f43c1-ab20-4187-b992-290f870c366d

	measure 'Overdue % YoY Change' =

			VAR _current = [Overdue %]
			VAR _prior = CALCULATE([Overdue %], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN
			IF(ISBLANK(_prior), BLANK(), _current - _prior)
		formatString: +0.0"pp";-0.0"pp";0.0"pp"
		lineageTag: 405e93d2-5a84-4636-a713-a53428780b1b

	measure 'Days Sales Outstanding YoY Growth %' =
			VAR _current = [Days Sales Outstanding]
			VAR _prior = CALCULATE([Days Sales Outstanding], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 88bdea4a-2552-4e7b-8276-4a7576c58789

