		summarizeBy: sum
		sourceColumn: outstanding_amount_gbp

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column invoice_amount_usd
		dataType: double
		sourceProviderType: decimal(37, 8)
		lineageTag: 42597b28-942f-45c0-a503-d526f68eacc8
		summarizeBy: sum
		sourceColumn: invoice_amount_usd

