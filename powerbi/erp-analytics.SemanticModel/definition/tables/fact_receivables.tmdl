		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column is_overdue
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		sourceProviderType: bit
		lineageTag: 45ce3487-4ffe-4804-b5a0-569918be3aab
		summarizeBy: none
		sourceColumn: is_overdue

		annotation SummarizationSetBy = Automatic

	column 'Order Size Tier' =

			SWITCH(
			    TRUE(),
			    fact_receivables[invoice_amount_gbp] < 100, "Under £100",
			    fact_receivables[invoice_amount_gbp] < 500, "£100 - £500",
			    fact_receivables[invoice_amount_gbp] < 1000, "£500 - £1,000",
			    "Over £1,000"
			)
		lineageTag: 31bd2b13-ef6c-48a5-9881-a7dcd1908e1f
		summarizeBy: none
		sortByColumn: 'Order Size Tier Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Order Size Tier Sort' =

			SWITCH(
			    TRUE(),
			    fact_receivables[invoice_amount_gbp] < 100, 1,
			    fact_receivables[invoice_amount_gbp] < 500, 2,
			    fact_receivables[invoice_amount_gbp] < 1000, 3,
			    4
			)
		formatString: 0
		lineageTag: a7c5225b-4100-4f55-be1d-acdfe2d52a64
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

