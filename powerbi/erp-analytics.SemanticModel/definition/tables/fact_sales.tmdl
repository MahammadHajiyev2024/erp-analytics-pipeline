table fact_sales
	lineageTag: ea5d8190-7b0e-4604-a2cf-3402d7fb990d

	measure 'Net Revenue' =
			VAR _gbp = SUM(fact_sales[net_amount_gbp])
			VAR _usd = SUM(fact_sales[net_amount_usd])
			RETURN SWITCH(SELECTEDVALUE('Currency'[Currency], "GBP"), "USD", _usd, _gbp)
		lineageTag: 72962f42-fae7-4a4a-bcb8-248eba732fab

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Currency'[Currency], "GBP"),
				    "USD", "$#,0.0",
				    "£#,0.0"
				)

	measure 'Gross Profit' =
			VAR _gbp = SUM(fact_sales[net_amount_gbp]) - SUM(fact_sales[cost_amount_gbp])
			VAR _usd = SUM(fact_sales[net_amount_usd]) - SUM(fact_sales[cost_amount_usd])
			RETURN SWITCH(SELECTEDVALUE('Currency'[Currency], "GBP"), "USD", _usd, _gbp)
		lineageTag: a2b81ee5-92a0-455f-b398-058980906894

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Currency'[Currency], "GBP"),
				    "USD", "$#,0.0",
				    "£#,0.0"
				)

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Net Revenue])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 483af8ec-2925-4487-a638-14ced3b8c732

	measure 'Average Order Value' = DIVIDE([Net Revenue], DISTINCTCOUNT(fact_sales[invoice_id]))
		lineageTag: 81c5c1e3-7fee-434f-8f45-5d26b9af381e

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Currency'[Currency], "GBP"),
				    "USD", "$#,0.0",
				    "£#,0.0"
				)

	measure 'Return Rate %' =
			VAR _returns = CALCULATE(SUM(fact_sales[net_amount_gbp]), fact_sales[is_return] = TRUE())
			VAR _gross = CALCULATE(SUM(fact_sales[net_amount_gbp]), fact_sales[is_return] = FALSE())
			RETURN DIVIDE(-1 * _returns, _gross)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4792f1e8-d290-4a2d-8bb2-ad61bf5e2e2d

	measure 'Repeat Purchase Rate' =
			VAR _activeCustomers = CALCULATETABLE(VALUES(dim_customer[customer_key]), fact_sales)
			VAR _repeatCustomers =
					FILTER(_activeCustomers, CALCULATE(DISTINCTCOUNT(fact_sales[invoice_id])) > 1)
			RETURN DIVIDE(COUNTROWS(_repeatCustomers), COUNTROWS(_activeCustomers))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 461a65df-2667-4314-b4a4-a14209987bdd

	measure 'YoY Growth %' =

			VAR _current = [Net Revenue]
			VAR _prior = CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('dim_date'[date]))

			RETURN
			DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c7f4303e-9d20-4754-aecf-ccda31030d2b

	measure 'Customer Revenue Change %' =
			VAR _last3 = CALCULATE([Net Revenue], DATESINPERIOD('dim_date'[date], MAX('dim_date'[date]), -3, MONTH))
			VAR _prior3 =
					CALCULATE(
							[Net Revenue],
							DATESINPERIOD('dim_date'[date], MAX('dim_date'[date]) - 90, -3, MONTH)
					)
			RETURN DIVIDE(_last3 - _prior3, _prior3)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 266a5b55-c3cb-4d8b-ba7f-ed368925fade

	measure 'Seasonal Index' =
			VAR _monthsInContext = VALUES('dim_date'[month])
			VAR _monthlyTotals =
					SUMMARIZE(
							ALL('dim_date'),
							'dim_date'[year],
							'dim_date'[month],
							"MonthQty", CALCULATE(SUM(fact_sales[quantity]))
					)
			VAR _avgForTheseMonths =
					AVERAGEX(FILTER(_monthlyTotals, 'dim_date'[month] IN _monthsInContext), [MonthQty])
			VAR _avgAllMonths = AVERAGEX(_monthlyTotals, [MonthQty])
			RETURN DIVIDE(_avgForTheseMonths, _avgAllMonths)
		formatString: 0.0
		lineageTag: 56915676-8a3c-496b-91a0-1444b8874bdc

	measure 'Product Pair Frequency' =
			VAR _productB = SELECTEDVALUE('Product B'[product_id])
			VAR _invoicesWithRowProduct = VALUES(fact_sales[invoice_id])
			RETURN
			CALCULATE(
					DISTINCTCOUNT(fact_sales[invoice_id]),
					TREATAS(_invoicesWithRowProduct, fact_sales[invoice_id]),
					TREATAS({_productB}, dim_product[product_id])
			)
		formatString: #,0.0
		lineageTag: 429accaa-2c96-4ed2-8d46-ab827497e239

	measure 'Total Active Customers' = DISTINCTCOUNT(fact_sales[customer_key])
		formatString: #,0.0
		lineageTag: 4f455bfa-d364-486e-aff1-90b3f5713e99

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[invoice_id])
		formatString: #,0.0
		lineageTag: 8b1fad0c-65e3-46f9-a6a1-78e80789cf6f

	measure 'Total Units Sold' = SUM(fact_sales[quantity])
		formatString: #,0.0
		lineageTag: 2806169a-bde0-43d4-86b3-2c0088b8a195

	measure 'Gross Profit YoY Growth %' =
			VAR _current = [Gross Profit]
			VAR _prior = CALCULATE([Gross Profit], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6b43cfb0-59f6-4ddf-9fc0-459f6d5e66fe

	measure 'Gross Margin % YoY Change' =
			VAR _current = [Gross Margin %]
			VAR _prior = CALCULATE([Gross Margin %], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN _current - _prior
		formatString: +0.0"pp";-0.0"pp";0.0"pp"
		lineageTag: fc5dc022-2e3d-46e4-849b-1e6092753699

	measure 'Average Order Value YoY Growth %' =
			VAR _current = [Average Order Value]
			VAR _prior = CALCULATE([Average Order Value], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1e273169-349a-4f04-b67b-53b87e1e0d5d

	measure 'Return Rate % YoY Change' =
			VAR _current = [Return Rate %]
			VAR _prior = CALCULATE([Return Rate %], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN _current - _prior
		formatString: +0.0"pp";-0.0"pp";0.0"pp"
		lineageTag: 245a1e3f-16ce-4e51-8505-2ee8591c579f

	measure 'Repeat Purchase Rate YoY Change' =
			VAR _current = [Repeat Purchase Rate]
			VAR _prior = CALCULATE([Repeat Purchase Rate], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN _current - _prior
		formatString: +0.0"pp";-0.0"pp";0.0"pp"
		lineageTag: 87a4d5b9-6549-400c-b3cc-cede4393c688

	measure 'Total Active Customers YoY Growth %' =
			VAR _current = [Total Active Customers]
			VAR _prior = CALCULATE([Total Active Customers], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bd852774-de3e-4397-bff8-7a80295fff43

	measure 'Total Orders YoY Growth %' =
			VAR _current = [Total Orders]
			VAR _prior = CALCULATE([Total Orders], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0c4568f7-0bfc-4721-8600-c68b44c4b3a8

	measure 'Total Units Sold YoY Growth %' =
			VAR _current = [Total Units Sold]
			VAR _prior = CALCULATE([Total Units Sold], SAMEPERIODLASTYEAR('dim_date'[date]))
			RETURN DIVIDE(_current - _prior, _prior)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 273a0d37-e79f-4247-bf7d-78f598bda134

